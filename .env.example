# Configurações do Gateway FreePay Brasil
# Obtenha suas credenciais no painel da FreePay em "Credenciais API":
# https://freepaybrasil.readme.io/reference/introdução

FREEPAY_PUBLIC_KEY=sua_public_key_aqui
FREEPAY_SECRET_KEY=sua_secret_key_aqui
FREEPAY_POSTBACK_URL=https://seudominio.com/api/webhook/freepay

# Porta do servidor local (padrão: 3000)
PORT=3000
